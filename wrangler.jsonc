{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "edenloteamiento",
  "main": "./src/index.js",
  "compatibility_date": "2026-07-22",
  "observability": {
    "enabled": true
  },
  "assets": {
    "directory": "./public",
    "binding": "ASSETS",
    "run_worker_first": true
  }
}
